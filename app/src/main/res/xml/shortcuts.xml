<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@android:drawable/ic_input_add"
        android:shortcutId="shortcut_add_expense"
        android:shortcutLongLabel="@string/shortcut_add_expense"
        android:shortcutShortLabel="@string/shortcut_add_expense">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.piecer.app.MainActivity"
            android:targetPackage="com.piecer.app">
            <extra
                android:name="extra_start_route"
                android:value="add_transaction" />
            <extra
                android:name="extra_quick_type"
                android:value="EXPENSE" />
        </intent>
    </shortcut>

    <shortcut
