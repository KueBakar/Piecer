            <extra
                android:name="extra_start_route"
                android:value="add_transaction" />
            <extra
                android:name="extra_quick_type"
                android:value="INCOME" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
